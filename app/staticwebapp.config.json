{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 401
    },
    "403": {
      "statusCode": 403
    },
    "404": {
      "statusCode": 404
    },
    "500": {
      "statusCode": 500
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "*.{css,gif,ico,jpg,js,png,txt,svg,webp,woff,woff2}"
    ]
  }
}
